{
  "name": "cybershield-wifi",
  "version": "2.0.0",
  "description": "Zero-trust Wi-Fi security: a rule-based risk engine with an Isolation Forest anomaly check, live Wi-Fi risk scoring, local-first IP purpose intelligence, and opt-in consented NextDNS activity.",
  "main": "backend/main.py",
  "scripts": {
    "setup": "pip install -r backend/requirements.txt",
    "start": "python3 -m uvicorn main:app --host ${CYBERSHIELD_HOST:-127.0.0.1} --port ${PORT:-8000} --app-dir backend",
    "dev": "python3 -m uvicorn main:app --reload --host ${CYBERSHIELD_HOST:-127.0.0.1} --port ${PORT:-8000} --app-dir backend",
    "test": "python3 -m unittest discover -s tests -v",
    "health": "node -e \"fetch('http://127.0.0.1:'+(process.env.PORT||8000)+'/api/stats').then(r=>r.text().then(t=>console.log(r.status,t))).catch(e=>{console.error('DOWN',e.message);process.exit(1)})\"",
    "docker": "docker compose up --build"
  },
  "keywords": [
    "wifi",
    "wifi-security",
    "zero-trust",
    "cybersecurity",
    "network-security",
    "fastapi",
    "threat-detection",
    "ip-reputation",
    "nextdns",
    "dns-security"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rakesh161206/cybershield-wifi.git"
  },
  "bugs": {
    "url": "https://github.com/rakesh161206/cybershield-wifi/issues"
  },
  "homepage": "https://github.com/rakesh161206/cybershield-wifi#readme",
  "engines": {
    "node": ">=18"
  }
}
