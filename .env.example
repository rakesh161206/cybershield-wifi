# CyberShield Wi-Fi — environment configuration
#
# Copy to .env and export the values, or set them inline:
#   set -a && . ./.env && set +a && ./run.sh
#
# Every variable is optional. The defaults are the safe ones.

# --- server binding -------------------------------------------------------
# Bind address. 127.0.0.1 means only this machine can reach the dashboard.
# Change to 0.0.0.0 ONLY if you understand the exposure (see below).
CYBERSHIELD_HOST=127.0.0.1
PORT=8000

# --- optional: phone / LAN viewing ----------------------------------------
# If you set CYBERSHIELD_HOST to 0.0.0.0, list every hostname or IP that
# is allowed to reach the server. The Host header is checked against this
# list, which is what blocks DNS-rebinding attacks.
#CYBERSHIELD_ALLOWED_HOSTS=192.168.1.20
#CYBERSHIELD_ALLOWED_ORIGINS=http://192.168.1.20:8000

# --- optional: session token ----------------------------------------------
# Every state-changing request (block, disconnect, capture, ...) must carry
# this value in the X-CyberShield-Token header. By default a random token
# is generated on every start, and the dashboard fetches it from
# GET /api/session. Set this only if you want a stable token across restarts.
#CYBERSHIELD_TOKEN=change-me-to-something-long-and-random

# --- optional: IP intelligence ---------------------------------------------
# Geolocation is OFF by default because it sends an observed IP address to a
# third-party resolver. Turn it on only if you accept that.
#CYBERSHIELD_GEO=0
#CYBERSHIELD_GEO_PROVIDER=ip-api.com

# --- optional: consented network-wide DNS telemetry -----------------------
# A Wi-Fi client cannot see another client's traffic on a hotspot. If each
# participant explicitly points their device at a NextDNS profile, that
# profile's query log gives domain-level activity for those devices.
#
# Create a profile at https://nextdns.io, enable query logging, then either
# use "Connect & test" in the DNS Activity tab or set both values below.
# Environment variables take precedence over the local connect form.
# The API key is read by the backend only and is never returned by the API.
# Leave both unset to use the DNS Activity tab's setup form instead.
#NEXTDNS_API_KEY=your-private-api-key
#NEXTDNS_PROFILE_ID=your-profile-id
#
# How often the background worker fetches new logs while a profile is
# connected (minimum 15 seconds; the dashboard itself polls every 10s).
#NEXTDNS_POLL_SECONDS=60
#
# CyberShield keeps a local copy of the latest events so device timelines and
# investigation searches survive a NextDNS log rollover. Older rows are
# pruned automatically. NextDNS retains its own copy separately.
#DNS_RETENTION_DAYS=30

# Override only for testing or a compatible self-hosted endpoint.
#NEXTDNS_BASE_URL=https://api.nextdns.io
